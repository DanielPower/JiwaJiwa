{
  "title": "Try it",
  "plot": "Yuki brings her finished words to the studio; Rin has her sing them, Daichi tries his drums on it, and the summer song gets a name.",
  "topic": "te-miru",
  "paragraphs": [
    [["スタジオに来た。", "I came to the studio."], ["手に、ノートがある。", "I have my notebook in my hand."]],
    [["ユキ|「…言葉、書いてみた。」", "\"…I tried writing the words.\""]],
    [["ダイチ|「本当に！？聞きたい！」", "\"Really!? I want to hear!\""], ["リン|「…ダイチ、待って。」", "\"…Daichi, wait.\""]],
    [["リンが、私を見た。", "Rin looked at me."], ["リン|「…歌ってみて。」", "\"…Try singing it.\""]],
    [["ユキ|「今？」", "\"Now?\""], ["リン|「今。」", "\"Now.\""]],
    [["リンが、ギターを弾いた。", "Rin played her guitar."], ["雨みたいな、あの曲だ。", "That tune like the rain."]],
    [["私は、ベースを弾かない。", "I don't play my bass."], ["今日は、私の声と、リンのギター。", "Today, it's just my voice and Rin's guitar."]],
    [["私は、歌ってみた。", "I tried singing it."]],
    [["『一人の夜じゃない』", "'It's not a lonely night.'"]],
    [["『公園の、夏の空』", "'The summer sky over the park.'"]],
    [["『うるさい音と、静かな音』", "'A loud sound, and a quiet one.'"]],
    [["『三人の、夏』", "'A summer for three.'"]],
    [["最後に、もう一回。", "And at the end, once more:"], ["『一人の夜じゃない』", "'It's not a lonely night.'"]],
    [["曲が終わった。", "The song ended."]],
    [["誰も、何も言わない。", "Nobody says anything."]],
    [["ダイチを見た。", "I looked at Daichi."], ["ダイチが、泣いている。", "Daichi is crying."]],
    [["ダイチ|「…泣いちゃった。」", "\"…I'm crying.\""], ["リン|「…うるさい。」", "\"…You're loud.\""], ["でも、リンの声も、ちょっと…", "But Rin's voice was a little… too."]],
    [["ダイチ|「『うるさい音』って、俺？」", "\"'A loud sound', is that me?\""], ["ユキ|「ダイチ。」", "\"Yes, you.\""], ["ダイチ|「最高！」", "\"Awesome!\""]],
    [["ダイチ|「じゃあ、ドラムも、やってみる！」", "\"Right, I'll try it with drums!\""]],
    [["三人で、やってみた。", "The three of us tried it together."]],
    [["ダイチのドラムが、大きい。", "Daichi's drums are loud."], ["リン|「…ダイチ、静かにしてみて。」", "\"…Daichi, try playing it quieter.\""]],
    [["ダイチが、静かにやってみた。", "Daichi tried it quieter."], ["…いい。", "…Good."], ["もう一回、やってみた。", "We tried it once more."], ["もっといい。", "Even better."]],
    [["ダイチ|「この曲の名前は？」", "\"What's this song called?\""]],
    [["ユキ|「…『一人の夜じゃない』？」", "\"…'It's Not a Lonely Night'?\""], ["ダイチ|「長い！」", "\"Too long!\""]],
    [["リン|「…『夏の夜』。」", "\"…'Summer Night'.\""]],
    [["ユキ|「夏の夜…」", "\"Summer Night…\""], ["ユキ|「うん。それがいい。」", "\"Yeah. That's the one.\""]],
    [["ダイチ|「『雪』と、『桜』と、『夏の夜』！」", "\"'Snow', 'Cherry Blossoms', and 'Summer Night'!\""], ["ダイチ|「祭りの曲が、できた！」", "\"Our festival set is ready!\""]],
    [["リン|「…もう一回。」", "\"…Again.\""]],
    [["私は、笑った。", "I laughed."], ["もう一回、歌ってみよう。", "Let's try it one more time."]]
  ]
}
