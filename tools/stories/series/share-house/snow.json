    [["一緒に、外の雪を見た。", "Together, we watched the snow."]],
    [["ケンタ|「来年も、一緒にゲーム…」", "\"Next year too… games together…\""], ["アレックス|「うん！カナダから！」", "\"Yeah! From Canada!\""]],
