{
  "title": "Snow",
  "plot": "Snow in Tokyo; Alex will be in Canada next year.",
  "paragraphs": [
    [["冬だ。", "It's winter."], ["外は、雪だ！", "It's snowing outside!"]],
    [["アレックス|「雪！東京に雪！」", "\"Snow! Snow in Tokyo!\""], ["ユキ|「寒いね。」", "\"It's cold, huh.\""]],
    [["空から、雪。", "Snow, from the sky."], ["外がきれいだ。", "It's beautiful out there."]],
    [["ケンタ|「寒いから、ゲーム。」", "\"It's cold, so: games.\""]],
    [["アレックス|「ケンタ、仕事は？」", "\"Kenta, what about work?\""], ["ケンタ|「春から。」", "\"Not till spring.\""]],
    [["ユキ|「アレックス、来年は？」", "\"Alex, what about next year?\""], ["アレックス|「来年は…カナダ。」", "\"Next year… Canada.\""]],
