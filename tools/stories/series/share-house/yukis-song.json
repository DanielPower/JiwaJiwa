{
  "title": "Yuki's song",
  "plot": "Yuki writes a new song for Alex because he's leaving.",
  "paragraphs": [
    [["秋の夜。", "An autumn night."]],
    [["ボン、ボン、ボン。", "Boom, boom, boom."], ["ユキのベースだ。", "It's Yuki's bass."]],
    [["アレックス|「新しい曲？」", "\"A new song?\""], ["ユキ|「うん、新しい曲だよ。」", "\"Yeah, a new song.\""]],
    [["ユキ|「ライブの曲だよ。」", "\"It's for a gig.\""]],
    [["アレックス|「ユキが歌う？」", "\"Are you singing?\""], ["ユキ|「歌わない！ベースだから。」", "\"No! I play bass.\""]],
    [["ユキ|「でも、アレックスの曲だよ。」", "\"But it's your song.\""]],
    [["アレックス|「アレックスの曲？」", "\"My song?\""], ["ユキ|「うん。アレックスが帰るから。」", "\"Yeah. Because you're going home.\""]],
    [["アレックス|「ユキ…ありがとう。」", "\"Yuki… thank you.\""]],
    [["ユキ|「ケンタも、ミホさんも、来るよ。」", "\"Kenta and Miho are coming too.\""]],
    [["ボン、ボン。", "Boom, boom."], ["新しい曲は、きれいだ。", "The new song is beautiful."]]
  ]
}
