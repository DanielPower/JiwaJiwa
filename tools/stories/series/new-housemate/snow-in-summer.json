    [["ユキさんが、笑った。", "Yuki smiled."]],
    [["ミホ|「ユキ！最高だった！」", "\"Yuki! That was amazing!\""], ["ケンタ|「…いい歌だった。」", "\"…That was a good song.\""]],
    [["ソラ|「ユキさん！」", "\"Yuki!\""], ["ユキ|「ソラ…ありがとう。」", "\"Sora… thank you.\""]],
