{
  "title": "Through the wall",
  "plot": "Late at night, Sora hears someone singing in Yuki's room.",
  "topic": "janai",
  "paragraphs": [
    [["夜だ。", "Night."], ["僕は、部屋でマンガを読んでいる。", "I'm in my room, reading manga."]],
    [["ボン、ボン。", "Boom, boom."], ["ユキさんのベースだ。", "Yuki's bass."]],
    [["ソラ|「また、ベース…」", "\"The bass again…\""]],
    [["…ベースじゃない。", "…No. That's not the bass."]],
    [["歌だ。", "It's singing."], ["ユキさんの部屋から、歌の声。", "A voice singing, from Yuki's room."]],
    [["ソラ|「…ユキさんの声じゃない？」", "\"…Isn't that Yuki's voice?\""]],
    [["ケンタさんじゃない。", "It's not Kenta."], ["ケンタさんは、今夜は会社だ。", "Kenta's at the office tonight."]],
    [["知らない曲だ。", "A song I don't know."], ["新しい曲？", "A new song?"]],
    [["声が、きれいだ。", "Her voice is beautiful."]],
    [["歌に、『雪』がある。", "\"Snow\" is in the song."], ["冬の歌だ。", "A winter song."]],
    [["僕は、マンガを読まない。", "I've stopped reading."]],
    [["ソラ|「ユキさん、歌、うまいじゃん…」", "\"Yuki's a really good singer…\""]],
    [["…もう、歌はない。", "…The singing's stopped."]],
    [["ソラ|「もう一回…」", "\"One more time…\""]]
  ]
}
