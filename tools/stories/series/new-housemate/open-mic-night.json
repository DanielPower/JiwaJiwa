{
  "title": "Open mic night",
  "plot": "At the live house, people take turns at the mic; Yuki only watches, and Kenta turns up late.",
  "paragraphs": [
    [["夜だ。", "Night."], ["ライブの店に来た。", "We came to the live house."]],
    [["人が多い。", "It's packed."], ["みんな、ビールを飲んでいる。", "Everyone's drinking beer."]],
    [["ミホ|「ソラさん、ユキ、こっち！」", "\"Sora, Yuki, over here!\""]],
    [["ソラ|「ケンタさんは？」", "\"Where's Kenta?\""], ["ユキ|「まだ仕事。」", "\"Still at work.\""]],
    [["店の人|「こんばんは！オープンマイクです！」", "\"Good evening! It's open mic night!\""]],
    [["ギターの人が、歌った。", "A guy with a guitar sang."], ["上手だ。", "He's good."]],
    [["ソラ|「上手！」", "\"He's good!\""], ["ミホ|「でしょ？」", "\"Right?\""]],
    [["ミホ|「私も、歌おう！」", "\"I'm singing too!\""]],
    [["ミホさんが歌った。", "Miho sang."], ["マンガの歌だ。", "A song from a manga."]],
    [["ソラ|「ミホさん、うまいじゃん！」", "\"Miho, you're good!\""], ["ユキ|「…うるさいね。」", "\"…She's loud.\""]],
    [["ベースの人も、歌った。", "Someone with a bass sang too."]],
    [["ユキさんは、ベースの人を見ている。", "Yuki's watching the bass player."]],
    [["ソラ|「ユキさん、ベースで歌う人だよ！」", "\"Yuki, she's singing with a bass!\""], ["ユキ|「…うん。」", "\"…Yeah.\""]],
    [["ソラ|「ユキさんも、歌おう！」", "\"You should sing too, Yuki!\""], ["ユキ|「歌わない。」", "\"I'm not singing.\""]],
    [["ミホ|「ユキ、一緒に歌おう！」", "\"Yuki, let's sing together!\""], ["ユキ|「ミホ、うるさい。」", "\"Miho, shush.\""]],
    [["ケンタさんが来た。", "Kenta came."], ["スーツだ。", "Still in his suit."]],
    [["ケンタ|「ごめん、仕事…ユキは？歌った？」", "\"Sorry, work… What about Yuki? Did she sing?\""], ["ソラ|「まだ。」", "\"Not yet.\""]],
    [["ケンタ|「ユキ、ベースは？」", "\"Yuki, where's your bass?\""], ["ユキ|「部屋。今日は、聞くの。」", "\"At home. Tonight I'm listening.\""]],
    [["ケンタ|「じゃあ、ビール飲もう。」", "\"Then let's have a beer.\""]],
    [["ユキさんは、マイクを見ている。", "Yuki's watching the mic."]],
    [["ソラ|「ユキさん…歌いたいんじゃない？」", "\"Yuki… don't you want to sing?\""]],
    [["ユキ|「…歌いたくないよ。」", "\"…I don't.\""]]
  ]
}
